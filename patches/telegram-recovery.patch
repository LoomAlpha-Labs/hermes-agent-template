--- a/plugins/platforms/telegram/adapter.py
+++ b/plugins/platforms/telegram/adapter.py
@@ -1712,7 +1712,17 @@ class TelegramAdapter(TelegramHeldInboundMixin, BasePlatformAdapter):
             self._write_runtime_status_safe(
                 "connected", platform_state="connected", error_code=None, error_message=None,
             )
+        was_degraded = self._send_path_degraded
         self._send_path_degraded = False
+        # In-place recovery does not run the adapter-replacement replay hook.
+        # Reuse the ledger's atomic claim so already-delivered replies stay sent.
+        replay = getattr(getattr(self, "gateway_runner", None), "_redeliver_failed_obligations_for_platform", None)
+        if was_degraded and callable(replay):
+            task = asyncio.get_running_loop().create_task(
+                replay(self.platform, profile=getattr(self, "_owner_profile", None)))
+            self._background_tasks.add(task)
+            task.add_done_callback(self._background_tasks.discard)
+            task.add_done_callback(_consume_abandoned_task)
         return True
 
     def _observe_polling_request_result(self, request, generation, result):
@@ -2150,7 +2160,8 @@ class TelegramAdapter(TelegramHeldInboundMixin, BasePlatformAdapter):
                 # No get_me() ⇒ not a live polling client (torn down / test double): exit, don't spin.
                 if not callable(getattr(bot, "get_me", None)):
                     return
-                await asyncio.wait_for(bot.get_me(), PROBE_TIMEOUT)
+                await asyncio.wait_for(
+                    bot.get_me(connect_timeout=3.0, read_timeout=5.0, pool_timeout=2.0), PROBE_TIMEOUT)
                 # get_me() refreshes PTB's cached bot user: adopt a BotFather rename before routing on it.
                 self._bot_identity_checked_at = time.monotonic()
                 self._note_bot_username(getattr(bot, "username", None))
@@ -3633,7 +3644,16 @@ class TelegramAdapter(TelegramHeldInboundMixin, BasePlatformAdapter):
                 return SendResult(success=False, error="Not connected", retryable=True)
         # getattr() — tests build adapters via object.__new__() (no __init__).
         if getattr(self, "_send_path_degraded", False):
-            return SendResult(success=False, error="send_path_degraded", retryable=True)
+            # An in-place polling restart retains _bot. Wait for its actual I/O
+            # proof, otherwise the outer 2s/4s retries expire before recovery.
+            progress = getattr(self, "_polling_progress_event", None)
+            if getattr(self, "_running", False) and progress is not None and not self._is_permanent_fatal():
+                try:
+                    await asyncio.wait_for(progress.wait(), timeout=30.0)
+                except asyncio.TimeoutError:
+                    pass
+            if getattr(self, "_send_path_degraded", False):
+                return SendResult(success=False, error="send_path_degraded", retryable=True)
         # Skip whitespace-only text to prevent Telegram 400 empty-text errors.
         if not content or not content.strip():
             return SendResult(success=True, message_id=None)
